<!-- LIGHTBOX OVERLAY -->
<div id="lb" class="lb" aria-hidden="true">
  <button class="lb__close" aria-label="Zavřít">✕</button>
  <button class="lb__nav lb__prev" aria-label="Předchozí">&#10094;</button>
  <figure class="lb__stage">
    <img class="lb__img" alt="">
    <figcaption class="lb__cap" aria-live="polite"></figcaption>
  </figure>
  <button class="lb__nav lb__next" aria-label="Další">&#10095;</button>
</div>

<style>
/* ===== Lightbox – vzhled ===== */
.lb{
  position: fixed; inset: 0; z-index: 9999;
  display: none; /* JS přepne na flex */
  align-items: center; justify-content: center; gap: 12px;
  background: rgba(0,0,0,.92);
}
.lb--open{ display: flex; }
.lb__stage{ margin:0; max-width: 92vw; max-height: 92vh; display:flex; flex-direction:column; align-items:center; gap:10px; }
.lb__img{ max-width: 92vw; max-height: 80vh; width:auto; height:auto; border-radius: 6px; box-shadow: 0 8px 30px rgba(0,0,0,.4); }
.lb__cap{ color:#eee; font-size:.95rem; text-align:center; max-width: min(92vw, 900px); min-height: 1.2em; }
.lb__close{
  position: absolute; top: 12px; right: 12px;
  background: transparent; border: 2px solid rgba(255,255,255,.7);
  color:#fff; font-size: 18px; line-height: 1; padding: 6px 10px; border-radius: 6px; cursor:pointer;
}
.lb__nav{
  background: rgba(255,255,255,.12); border: none; color:#fff; cursor: pointer;
  width: 44px; height: 44px; border-radius: 50%; display:grid; place-items:center;
  font-size: 24px; user-select:none;
}
.lb__nav:hover{ background: rgba(255,255,255,.2); }
.lb__prev{ position: absolute; left: 12px; }
.lb__next{ position: absolute; right:12px; }
@media (max-width: 768px){
  .lb__img{ max-height: 70vh; }
  .lb__prev, .lb__next{ top: auto; bottom: 12px; }
}
</style>

<script>
(function(){
  // Vyber obrázky z Ghost galerie i z běžného obsahu článku
  const GALLERY_SELECTOR = '.kg-gallery-card';
  const IMAGE_SELECTOR   = '.kg-gallery-card img, .gh-content img';

  const overlay = document.getElementById('lb');
  const imgEl   = overlay.querySelector('.lb__img');
  const capEl   = overlay.querySelector('.lb__cap');
  const btnClose= overlay.querySelector('.lb__close');
  const btnPrev = overlay.querySelector('.lb__prev');
  const btnNext = overlay.querySelector('.lb__next');

  let group = [];     // [{src, alt, cap, el}]
  let index = 0;

  // Pomocná: vezmi největší URL ze srcsetu (poslední)
  function largestSrc(img){
    const ss = img.getAttribute('srcset');
    if(!ss) return img.currentSrc || img.src;
    const last = ss.split(',').pop().trim();
    return last.split(' ')[0];
  }

  // Vyrob skupinu z nejbližší galerie, jinak jen z jednotlivých obrázků
  function buildGroup(fromImg){
    const gallery = fromImg.closest(GALLERY_SELECTOR);
    const imgs = gallery ? Array.from(gallery.querySelectorAll('img')) 
                         : [fromImg]; // fallback jediný obrázek
    return imgs.map(i => {
      // figcaption, pokud existuje
      let cap = '';
      const fig = i.closest('figure');
      const fc = fig ? fig.querySelector('figcaption') : null;
      if (fc) cap = fc.textContent.trim();
      const alt = i.getAttribute('alt') || '';
      return { src: largestSrc(i), alt, cap, el:i };
    });
  }

  function openAt(img){
    group = buildGroup(img);
    index = group.findIndex(it => it.el === img);
    if (index < 0) index = 0;
    show(index);
    overlay.classList.add('lb--open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function close(){
    overlay.classList.remove('lb--open');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  function show(i){
    if (!group.length) return;
    index = (i + group.length) % group.length;
    const it = group[index];
    imgEl.src = it.src;
    imgEl.alt = it.alt || '';
    capEl.textContent = it.cap || it.alt || '';
  }

  // Ovládání
  btnClose.addEventListener('click', close);
  btnPrev.addEventListener('click', () => show(index-1));
  btnNext.addEventListener('click', () => show(index+1));
  overlay.addEventListener('click', (e) => {
    // klik mimo obraz zavře
    const inside = e.target.closest('.lb__stage') || e.target.closest('.lb__nav') || e.target.closest('.lb__close');
    if (!inside) close();
  });
  window.addEventListener('keydown', (e) => {
    if (!overlay.classList.contains('lb--open')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') show(index-1);
    if (e.key === 'ArrowRight') show(index+1);
  });

  // Swipe (mobil)
  let sx = null;
  overlay.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; }, {passive:true});
  overlay.addEventListener('touchend', (e) => {
    if (sx == null) return;
    const dx = e.changedTouches[0].clientX - sx;
    if (Math.abs(dx) > 40) { dx < 0 ? show(index+1) : show(index-1); }
    sx = null;
  });

  // Navěs kliky na obrázky (delegace – kdyby se obsah měnil lazy)
  function bindClicks(root=document){
    root.querySelectorAll(IMAGE_SELECTOR).forEach(img=>{
      if (img.dataset.lbBound) return;
      img.dataset.lbBound = '1';
      img.style.cursor = 'zoom-in';
      img.addEventListener('click', (e)=>{ e.preventDefault(); openAt(img); });
    });
  }
  bindClicks();

  // Kdyby Ghost dynamicky dosadil obsah (např. infinite scroll), zavolej bindClicks znovu.
  // window.addEventListener('gh-content-updated', ()=>bindClicks());
})();
</script>


<script src="{{asset "built/casper.js"}}"></script>
