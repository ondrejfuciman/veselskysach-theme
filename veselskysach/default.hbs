<style> 
/* jen levý obrázek v headeru */
.left-image .header-image-mobile{
  display:block;
  /* zaobli JEN spodní rohy – elipticky, ať to nevypadá jako „půlkruh“ */
  border-radius: 0 0 50% 50% / 0 0 45% 45%;
  /* volitelně: mírný rámeček, ať vynikne tvar */
  /* outline: 2px solid #c7da15; outline-offset:-2px; */
}


  .header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #c7da15;
}

.right-image img{
  width: auto;
  height: auto;
  object-fit: cover;         /* když budeš chtít vyplnit box: použij místo toho height + width + cover */
}


.right-image {
  order: 3;
  margin-right: 20px;
}

.left-image {
  order: 1;
  margin-left: 20px;
}

.header-title {
  order: 2;
  flex-grow: 1;
  text-align: center;
}

.home-button {
  position: relative;
  display: flex;
  justify-content: center;
  width: 100%; 
}

.home-button a {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  text-align: center;
  text-decoration: underline;
  color: black;
  font-weight: bold;
  font-size: large;
  background-color:#15da8e;
  width:33.33rem;
  height: 30px;
  border-radius: 3px;
}

@media (max-width: 768px) {
  .header-content {
    flex-direction: column;
    height: auto;
    align-items: center;      /* centrování dětí ve flexu */
    gap: 12px;
    min-height: auto;
    padding-block: 10px;
    padding-inline: clamp(8px, 4vw, 16px); /* symetrické vnitřní okraje */
  }
  
  .header-image-mobile {
    display: none;
    
  }
  
  .left-image img,
  .right-image img {
    max-width: 100%;
    width: auto;
    
  }
}

@media (min-width: 769px) {
    .NarrowViewportMenu-dropdown {
      display: none;
      opacity: 0;
      transition: opacity 0.3s ease; /* Add a transition effect */
    }
  }

/* Mobilní menu jen do 768 px */
@media (min-width: 769px){
  .nvm,
  .NarrowViewportMenu-dropdown{ display:none !important; }
}

/* Desktopový sidebar schovej na mobilu (pro jistotu) */
@media (max-width: 768px){
  .sidebar-menu{ display:none !important; }
}


  /* Display the container with full opacity on screens 768px or smaller */
  @media (max-width: 768px) {
    .NarrowViewportMenu-dropdown {
      display: block;
      opacity: 1;
    }
  }


  /* ===== Header (fluid) ===== */

.header-content{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap: clamp(12px, 2vw, 24px);
  /* žádná fixní výška – plynulé minimum/max */
  min-height: clamp(120px, 18vw, 210px);
  padding-block: clamp(6px, 1vw, 12px);
  background-color:#c7da15;
}

/* Levý blok s odznakem (SVG) */
.left-image{ display:flex; align-items:center; margin-left:20px; }
.left-image .brand-badge{
  /* šířka = výška; SVG si udrží poměr samo */
  width: clamp(120px, 14vw, 190px);
  height: auto;
  display:block;
  filter: drop-shadow(0 2px 10px rgba(0,0,0,.12));
}

/* Pravý obrázek */
.right-image{ display:flex; align-items:center; margin-right:20px; }
.right-image img{
  /* plynule mezi 110–168 px podle viewportu */
  max-height: clamp(110px, 14vw, 168px);
  width: auto;
  height: auto;
  object-fit: cover;
}

/* Titulek uprostřed */
.header-title{
  flex:1 1 auto;
  text-align:center;
}
.header-title h1{
  margin:0;
  font-weight:800;
  line-height:1.1;
  /* plynulá typografie */
  font-size: clamp(18px, 2.3vw, 36px);
}

/* Home button pod headerem – beze změny, jen kosmetika */
.home-button{
  position:relative;
  display:flex;
  justify-content:center;
  width:100%;
}
.home-button a{
  position:relative;
  display:flex;
  flex-direction:column;
  justify-content:center;
  text-align:center;
  text-decoration:underline;
  color:black;
  font-weight:bold;
  font-size:clamp(14px, 1.3vw, 18px);
  background-color:#15da8e;
  width:33.33rem;
  height:30px;
  border-radius:3px;
}

/* Mobile: na malých šířkách můžeš schovat pravý obrázek, odznak nechat (doporučuji) */
@media (max-width: 768px){
  .header-content{
    flex-direction:column;
    align-items:center;
    gap:12px;
    min-height:auto;           /* dovol smrštění */
    padding-block:10px;
  }
  .right-image img{ display:none; } /* skryj pravý obrázek na mobilu */
  /* pokud chceš schovat i odznak: .left-image .brand-badge{ display:none; } */
}

/* (Volitelné) extra velké monitory – trochu omez růst */
@media (min-width: 1600px){
  .header-content{ padding-block: 16px; }
  .left-image .brand-badge{ width: 180px; }
  .right-image img{ max-height: 168px; }
}

</style>

