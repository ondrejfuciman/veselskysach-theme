<style>
/* ===== Hlavní rozložení stránky (2 sloupce: úzký vlevo + obsah) ===== */

:root{
  --left-col-w: 260px;   /* šířka levého pruhu (Traxler + sidebar) */
  --layout-gap-x: 16px;  /* mezera mezi sloupci */
}

:root{
  --page-bg: #f4f9d8; /* smetanová – jemná, ne „křiklavá“ */
}
html, body{ background: var(--page-bg); }


/* --- sdílené středové plátno pro tag/page/feed --- */
:root{ --content-max: 980px; --content-narrow: 800px; }

.center-wrap{
  width: 100%;
  max-width: var(--content-max);
  margin: 40px auto 0;
  padding-inline: clamp(8px, 3vw, 20px);
  max-width: var(--content-narrow);
  margin-left: auto;
  margin-right: auto;   /* ⬅ aby se „narrow“ prvek vždy vycentroval */
}


/* užší varianta – stejně jako detail článku */
.center-wrap--narrow{ max-width: var(--content-narrow); }

/* embedy/iframe a „min-width:0“ aby nic nepřetékalo */
.gh-content{ min-width: 0; }
.gh-content iframe,
.gh-content .kg-embed-card,
.gh-content .kg-embed-card iframe{
  width: 100% !important;
  max-width: 100% !important;
  height: auto;
}

/* feed: nech se roztáhnout na 100% své středové plachty */
.post-feed{ display:block; }
.post-feed > .post-card{ width:100%; margin:0 0 20px; }


/* Bezpečný box-model & média */
*, *::before, *::after { box-sizing: border-box; }
img, video { max-width: 100%; height: auto; display: block; }
iframe { max-width: 100%; display: block; border: 0; }   /* ⬅ bez height:auto */


/* Žádný horizontální scroll od 100vw atd. */
html { overflow-x: clip; }
.viewport { width: 100%; }

/* 2-sloupcový řádek */
.main-container{
  display: flex;
  width: 100%;
  max-width: 100%;
  gap: var(--layout-gap-x);
}

/* Levý úzký pruh */
.left-scrolling-element{
  flex: 0 0 var(--left-col-w);
  width: var(--left-col-w);
}

/* Pravá část = obsah */
.center-aligned-element{
  flex: 1 1 auto;
  min-width: 0;          /* umožní smrštění obsahu bez přetékání */
}
.site-content{ width: auto; min-width: 0; }

/* === Vzhled horního boxu (Traxler) v levém pruhu === */
.Traxler-wrapper{
  display: block;
  background: #bdbdbd;
  border-radius: 5px;
  padding: 8px;
  margin-bottom: 8px;
}
.Traxler-link{ padding: 5px 5px 0; }
.Traxler-link a{ color: black; text-decoration: underline; font-weight: 700; }
.Traxler-photo{
  display: flex; justify-content: center; padding: 8px;
}
.Traxler-photo img{
  border-radius: 50%;
  max-width: 140px;       /* drž menší průměr, ať to sedí do úzkého sloupce */
}

/* Info odkazy pod Traxlerem */
.Info-links{ margin: 6px 0 10px; }
.Info-links a{
  display: inline-block;
  margin: 2px 4px 0 0;
  padding: 5px 10px;
  background-color: #008cba;
  color: #fff;
  text-decoration: none;
  border-radius: 5px;
  font-size: 1rem;
  transition: background-color .2s ease-in-out;
}
.Info-links a:hover{ background-color: #005b80; }

/* === Responsivita: na mobilu můžeš levý sloupec skrýt === */
@media (max-width: 768px){
  .left-scrolling-element{ display: none; }
  .center-aligned-element{ flex-basis: 100%; }
}

/* ===== Feed na indexu – necháme 1 sloupec přes celou šířku obsahu ===== */
.post-feed{ display: block; }
.post-feed > article.post-card{
  display: block;
  width: 100%;
  max-width: none;
  margin: 0 0 20px;
}


/* Pagination – vzhled v duchu tvých „zelených“ tlačítek */
.pagination{
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10px;
  margin: 24px 0 8px;
}

.pagination .page-prev,
.pagination .page-next{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6px 10px;
  background: #179b5b;
  color: #000;
  text-decoration: underline;
  font-weight: 700;
  border-radius: 5px;
  transition: background-color .12s ease, box-shadow .12s ease;
}

.pagination .page-prev:hover,
.pagination .page-next:hover{
  background: #18a067;
  box-shadow: 0 0 0 2px rgba(0,0,0,.06) inset;
}

.pagination .page-status{
  font-weight: 700;
  color: #000;
}


html, body { height: 100%; }
.viewport{
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}
.main-container{ flex: 1 0 auto; }   /* hlavní obsah roztáhne výšku */
.site-footer{ flex-shrink: 0; }       /* footer zůstane na dně */

</style>

</body>
</html>