<section class="calendar-section">
  <h2 class="calendar-title">Kalendář akcí</h2>

  <div class="calendar-wrap">
    <iframe
      class="calendar-frame"
      src="https://calendar.google.com/calendar/embed?src=fucimanms%40outlook.com&ctz=Europe%2FPrague&hl=cs&mode=AGENDA&showTitle=0&showPrint=0&showCalendars=0&showTz=0&showTabs=0&showDate=0&showNav=0"
      frameborder="0"
      scrolling="no"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade">
    </iframe>
  </div>

  <button class="calendar-open-btn" type="button" id="openCalendarModal">
    Otevřít kalendář
  </button>
</section>

<div class="calendar-modal" id="calendarModal" aria-hidden="true">
  <div class="calendar-modal-backdrop" id="calendarModalBackdrop"></div>

  <div class="calendar-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="calendarModalTitle">
    <button class="calendar-modal-close" type="button" id="closeCalendarModal" aria-label="Zavřít kalendář">
      ✕
    </button>

    <h2 class="calendar-modal-title" id="calendarModalTitle">Kalendář akcí</h2>

    <div class="calendar-modal-frame-wrap">
      <iframe
        class="calendar-modal-frame"
        src="https://calendar.google.com/calendar/embed?src=fucimanms%40outlook.com&ctz=Europe%2FPrague&hl=cs&mode=AGENDA&showTitle=0&showPrint=0&showCalendars=0&showTz=0&showTabs=0&showDate=0&showNav=0"
        frameborder="0"
        scrolling="no"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade">
      </iframe>
    </div>
  </div>
</div>

<style>
:root{
  --cal-height-desktop: 520px;
  --cal-height-mobile: 500px;
  --cal-radius: 8px;

  --panel-bg: #c7da15;
  --shadow: 0 2px 12px rgba(0,0,0,.12);
}

.calendar-section{ margin:16px 0 20px; }

.calendar-title{
  margin:0 0 8px;
  font-size:1.2rem;
  font-weight:700;
  text-align:center;
}

.calendar-wrap{
  position:relative;
  width:100%;
  height:var(--cal-height-desktop);
  border-radius:var(--cal-radius);
  overflow:hidden;
  box-shadow: var(--shadow);
  background: var(--panel-bg);
}

.calendar-frame{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  border:0;
}

.calendar-open-btn{
  display:block;
  width:100%;
  margin-top:10px;
  padding:10px 12px;
  border:0;
  border-radius:8px;
  background:#15da8e;
  color:#000;
  font-weight:700;
  cursor:pointer;
}

.calendar-open-btn:hover{
  filter:brightness(.97);
}

/* MODAL */
.calendar-modal{
  position:fixed;
  inset:0;
  display:none;
  z-index:10000;
}

.calendar-modal.is-open{
  display:block;
}

.calendar-modal-backdrop{
  position:absolute;
  inset:0;
  background:rgba(0,0,0,.58);
}

.calendar-modal-dialog{
  position:absolute;
  top:50%;
  left:50%;
  transform:translate(-50%, -50%);
  width:min(1100px, 92vw);
  height:min(85vh, 900px);
  background:#f4f9d8;
  border-radius:14px;
  box-shadow:0 10px 40px rgba(0,0,0,.28);
  padding:18px 18px 14px;
  display:flex;
  flex-direction:column;
}

.calendar-modal-title{
  margin:0 36px 12px 0;
  text-align:center;
  font-size:1.35rem;
  font-weight:700;
}

.calendar-modal-close{
  position:absolute;
  top:10px;
  right:10px;
  width:38px;
  height:38px;
  border:0;
  border-radius:8px;
  background:#e6e6e6;
  font-size:20px;
  cursor:pointer;
}

.calendar-modal-frame-wrap{
  position:relative;
  flex:1 1 auto;
  min-height:0;
  border-radius:10px;
  overflow:hidden;
  box-shadow: var(--shadow);
  background:#c7da15;
}

.calendar-modal-frame{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  border:0;
}

@media (max-width: 768px){
  .calendar-wrap{ height:var(--cal-height-mobile); }

  .calendar-modal-dialog{
    width:95vw;
    height:88vh;
    padding:14px;
  }

  .calendar-modal-title{
    font-size:1.1rem;
  }
}
</style>

<script>
(function () {
  const modal = document.getElementById('calendarModal');
  const openBtn = document.getElementById('openCalendarModal');
  const closeBtn = document.getElementById('closeCalendarModal');
  const backdrop = document.getElementById('calendarModalBackdrop');

  if (!modal || !openBtn || !closeBtn || !backdrop) return;

  function openModal() {
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  openBtn.addEventListener('click', openModal);
  closeBtn.addEventListener('click', closeModal);
  backdrop.addEventListener('click', closeModal);

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && modal.classList.contains('is-open')) {
      closeModal();
    }
  });
})();
</script>