<article class="gallery-card {{post_class}}">
  <a class="gallery-card__link" href="{{url}}" aria-label="{{title}}">
    {{#if feature_image}}
      <img class="gallery-card__thumb"
           srcset="{{img_url feature_image size="s"}} 300w,
                   {{img_url feature_image size="m"}} 600w,
                   {{img_url feature_image size="l"}} 1000w"
           sizes="(max-width: 600px) 100vw, 400px"
           src="{{img_url feature_image size="m"}}"
           alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
    {{else}}
      <div class="gallery-card__thumb gallery-card__thumb--placeholder" aria-hidden="true"></div>
    {{/if}}

    <div class="gallery-card__meta">
      <h2 class="gallery-card__title">{{title}}</h2>
      <time class="gallery-card__date" datetime="{{date format="YYYY-MM-DD"}}">{{date}}</time>
    </div>
  </a>
</article>
