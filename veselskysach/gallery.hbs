{{!< default}}

<main id="site-main" class="site-main center-wrap center-wrap--narrow">
  <header class="page-head">
    <h1 class="page-title">Fotogalerie</h1>
    <p class="page-desc">Výběr fotek z turnajů, soutěží družstev a jiných aktivit klubu.</p>
  </header>


  {{#if posts}}
    <section class="gallery-feed">
      {{#foreach posts}}
        {{> "gallery-card"}}
      {{/foreach}}
    </section>

    {{pagination}}
  {{else}}
    <p class="empty-state">Zatím nejsou nahrané žádné galerie.</p>
  {{/if}}
</main>



<style>

.page-head{ margin: 0 0 12px; }
.gallery-feed{ margin-top: 8px; } /* malá mezera pod perexem */

.gallery-feed{
  display:grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap:14px;
}
@media (min-width: 1200px){
  .gallery-feed{
    gap:16px;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  }
}
.empty-state{ text-align:center; padding:24px 0; }

/* karta */
.gallery-card{
  background:#f2f2f2;
  border-radius:8px;
  overflow:hidden;
  display:flex; flex-direction:column;
  transition: transform .12s ease, box-shadow .12s ease;
}
.gallery-card:hover{
  transform: translateY(-2px);
  box-shadow:0 8px 22px rgba(0,0,0,.12);
}
.gallery-card__link{
  color:inherit; text-decoration:none;
  display:flex; flex-direction:column; height:100%;
}
.gallery-card__thumb{
  width:100%; aspect-ratio: 4/3; object-fit:cover; display:block;
}
.gallery-card__thumb--placeholder{ background:#d9d9d9; }
.gallery-card__meta{ padding:10px 10px 12px; display:flex; flex-direction:column; gap:6px; }
.gallery-card__title{ margin:0; font-size:1.05rem; line-height:1.25; font-weight:700; }
.gallery-card__date{ font-size:.9rem; color:#666; }

/* pagination (pokud už v tématu máš vlastní, tohle klidně vynech) */
.pagination{
  display:flex; justify-content:center; align-items:center; gap:8px;
  margin: 18px 0 10px;
}
.pagination a, .pagination span{
  display:inline-flex; align-items:center; justify-content:center;
  min-width:36px; height:36px;
  padding:0 10px; border-radius:6px;
  text-decoration:none; font-weight:700;
  background:#179b5b; color:#000; text-decoration:underline;
}
.pagination .active{ background:#ebbb2b; }
.pagination a:hover{ background:#18a067; box-shadow:0 0 0 2px rgba(0,0,0,.06) inset; }
</style>
