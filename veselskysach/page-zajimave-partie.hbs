{{!< default}}

{{#post}}
<main class="site-main center-wrap center-wrap--narrow">
  <article class="article {{post_class}}">
    <header class="article-header gh-canvas">
      <h1 class="article-title">{{title}}</h1>
      {{#if custom_excerpt}}<p class="article-excerpt">{{custom_excerpt}}</p>{{/if}}
    </header>

    <section class="gh-content gh-canvas">
      {{content}}
    </section>

    <section class="post-feed">
      {{#get "posts" filter="tag:zajimave-partie" include="tags,authors" order="published_at desc" limit="all"}}
        {{#foreach posts}}
          {{> "post-card"}}
        {{/foreach}}
      {{/get}}
    </section>
  </article>
</main>
{{/post}}